# All keys are read ONLY by the backend (Next.js server). They never reach the browser bundle.
# Claude (primary storyteller)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI (fallback storyteller + images)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
# ChatGPT subscription via the official Codex CLI (local/desktop backend only).
# Install: npm i -g @openai/codex ; then run `codex login` and choose "Sign in with ChatGPT".
CHATGPT_SUBSCRIPTION_ENABLED=true
CODEX_BIN=codex
CODEX_MODEL=
# SQLite file location (default: ./data/aetherfall.db)
DATABASE_PATH=
